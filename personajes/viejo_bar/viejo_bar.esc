# El viejo pide la pistola (ítem inicial) y a cambio dropea el videojuego.
# Se le puede dar arrastrando la pistola sobre él, o desde el diálogo.
# Sin voces: todavía no están grabadas.

:talk
	global pistola_entregada = false
	stop_snd()

	?!
		- "> Viejo, quiero hablarle a la chica que está allá. ¿Me darías un consejo?"
			say("mike", "Viejo, quiero hablarle a la chica que está allá. ¿Me darías un consejo?")
			say("viejo_bar", "Joven, si eso es lo que quieres, sigue tu deseo. Solo te advierto que tendrás que enfrentarte a los peores monstruos si quieres llamar su atención: El tabaquismo. Ella es adicta a los cigarrillos, por lo que hasta que no consigas un pucho y un encendedor, no creo que te dé bolilla.")

			?!
				- "> ¿Quién sos? Nunca te había visto en este bar."
					say("mike", "¿Quién sos? Nunca te había visto en este bar.")
					say("viejo_bar", "Pibe... Vengo de muy lejos. Especialmente a buscarte a vos. Soy tu Gordon Freeman. Viajé por miles de dimensiones, por miles de videojuegos para encontrarte. En 30 años, morirás en tu batalla contra el cigarrillo electrónico, pero los desarrolladores te dieron otra oportunidad. Déjame tu arma y te explicaré qué es lo que tienes que hacer.")

					?!
						- "> ¿Acaso lo poseo?"
							say("mike", "¿Acaso lo poseo?")
							if pistola_entregada:
								say("viejo_bar", "Ya me diste lo que necesitaba. El videojuego es tuyo, pibe.")
							elif "pistola" in inventory:
								say("mike", "¿Hablás de esta pistola?")
								say("viejo_bar", "Eso es. Esa arma no pertenece a esta época.")
								inventory_remove("pistola")
								pistola_entregada = true
								set_active("juego", true)
								custom("juego", "DropFX", "dropear")
								say("viejo_bar", "Perfecto. Toma este videojuego. Es el juego más esperado en años. Quizás a ti no te interese, pero cualquier nerd daría lo que fuera por jugarlo.")
							else:
								say("viejo_bar", "Ya lo vas a entender, pibe.")
							done

						- "> irse"
							say("mike", "Nos re vimo")
							done

				- "> irse"
					say("mike", "Nos re vimo")
					done

		- "> irse"
			say("mike", "Nos re vimo")
			done

:use pistola
	global pistola_entregada = false
	say("viejo_bar", "Eso es. Esa arma no pertenece a esta época.")
	inventory_remove("pistola")
	pistola_entregada = true
	set_active("juego", true)
	custom("juego", "DropFX", "dropear")
	say("viejo_bar", "Perfecto. Toma este videojuego. Es el juego más esperado en años. Quizás a ti no te interese, pero cualquier nerd daría lo que fuera por jugarlo.")

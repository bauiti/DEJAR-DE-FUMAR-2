# Papá (casa1, living).
# - Después de hablar con él, se le cae la proteína al piso.
# - Arrastrando la "proteína de Mike" sobre él, se duerme y deja la consola libre.

:talk
	global papa_hablado = false
	global papa_dormido = false

	if papa_dormido:
		say("mike", "Está fundido. Mejor no lo despierto.")
	else:
		stop_snd()

		?!
			- "> ¿Qué hacés, viejito? ¿Desde cuándo te importan los fierros?"
				say("mike", "¿Qué hacés, viejito? ¿Desde cuándo te importan los fierros?")
				say("papa_casa", "Pendejo más respeto porfavor... 501, 502... no viste que ahora si no haces fierros sos un POBRE y que no vas hacer nada de tu vida, entonces ahora me levanto todas TODAS las mañanas para poder hacer 600 dominadas... 310, 311.", "PA_respuesta1.0")

				?!
					- "> Pero .... desde que tengo memoria, siempre fuiste EL VERDE del pueblo."
						say("mike", "Pero .... desde que tengo memoria, siempre fuiste EL VERDE del pueblo.")
						say("papa_casa", "BUENO, eso cambio pibe, no entendes que la gente cambia. Vos siempre estas juzgando y eso es mentalidad de POBRE y nunca vas a ser millonario si haces, digo... no haces lo que YO hago", "PA_respuesta1.1")
						say("mike", "..... ¿Quedó algo de lo que eras o solo sos esta abominación?")
						say("papa_casa", "Hoy a la las 3 de la madrugada estuve tirando todas esas cosas de POBRE que coleccionabamos juntos, me lo aconsejo mi guru. ¿Sabias que el a los 3 años con el trading ese se compro su primer corsa? Volviendo, todavia tengo cosas encima. Las voy a tirar cuando termine esta serie.... 405... 302... ", "PA_respuesta1.2")
						done

					- "> Viejo, ¿qué son todos estos tachos?"
						say("mike", "Viejo, ¿qué son todos estos tachos?")
						say("papa_casa", "Son todos los suplementos que tengo que tomar para haga efecto mi entrenamiento. De hecho son para toda la familia. Mi guru me dijo que la comida que compramos en la coperativa no nos iba a poner como unos malditos toros, entonces decidi que era lo mejor para todos.", "PA_respuesta1.3")
						say("mike", "Por lo que vi, la mayoría se toma con prescripción médica, es una locura que tengas todo esto acá. Cada vez que mamá se tomaba una 'Papa' para dormir porque estaba estresada hacías un escándalo")
						say("papa_casa", "Tu mamá solo toma farmacos porque es debil de mente. Esas cosas no te ponen como un maldito toro... 399...381", "PA_respuesta1.4")
						done

					- "> irse"
						say("mike", "Se me cuidan")
						done

			- "> Viejo, ¿qué son todos estos tachos?"
				say("mike", "Viejo, ¿qué son todos estos tachos?")
				say("papa_casa", "Son todos los suplementos que tengo que tomar para haga efecto mi entrenamiento. De hecho son para toda la familia. Mi guru me dijo que la comida que compramos en la coperativa no nos iba a poner como unos malditos toros, entonces decidi que era lo mejor para todos.", "PA_respuesta1.3")
				say("mike", "Por lo que vi, la mayoría se toma con prescripción médica, es una locura que tengas todo esto acá. Cada vez que mamá se tomaba una 'Papa' para dormir porque estaba estresada hacías un escándalo")
				say("papa_casa", "Tu mamá solo toma farmacos porque es debil de mente. Esas cosas no te ponen como un maldito toro... 399...381", "PA_respuesta1.4")
				done

			- "> irse"
				say("mike", "Se me cuidan")
				done

		# Después de la primera charla, se le cae un tacho de proteína
		if not papa_hablado:
			papa_hablado = true
			set_active("prote", true)
			custom("prote", "DropFX", "dropear")
			say("mike", "Se le cayó uno de sus tachos de proteína...")

:use proteina_mike
	global papa_dormido = false
	inventory_remove("proteina_mike")
	say("mike", "Tomá, viejo. Un batido de proteína recién hecho, especial para vos.")
	say("papa_casa", "¡Al fin alguien en esta casa que entiende de nutrición! 312... 313... ¿por qué me pesan tanto los brazos?... zzz")
	custom("papa_casa", "Dormido", "dormir")
	papa_dormido = true
	say("mike", "Listo. Ahora nadie me mira.")

:use prote
	say("papa_casa", "¿Mi proteína? Dejala donde estaba, pendejo... 320... 321...")

:use blister
	say("papa_casa", "Esas pastillas son de tu madre. Yo no tomo esas porquerías de débil.")

# Profe (escuela2, sala de profesores).
# Cambia el Vape 3000 (que está en la esfera) por la consola con videojuego
# ("gaming"). Se le puede dar arrastrando el ítem sobre él o desde el diálogo.

:talk
	global vape_liberado = false
	stop_snd()

	?!
		- "> Sos bastante lenteja para estar todo el dia tiki tiki con la compu."
			say("mike", "Sos bastante lenteja para estar todo el dia tiki tiki con la compu.")
			say("profe_escuela", "¿Quien te dejo pasar a la sala de profesores?, esto de la arquitectura lisergica no es de las cosas mas seguras.....", "P_respuesta1.0")

			?!
				- "> Yo creo que tenes algo para darme en esta habitacion"
					say("mike", "Yo creo que tenes algo para darme en esta habitacion")
					if vape_liberado:
						say("profe_escuela", "Ya te di el vape, pibe. No me hagas arrepentir.")
					else:
						say("profe_escuela", "Los nenes cada vez más atrevidos. Todo lo que les saco me lo quedo como premio. ¿Te pensas que sos tan vivo para que te devuelva algo?", "P_respuesta1.1")
						say("profe_escuela", "Igual de curioso nomas, que articulo te interesaria.....", "P_respuesta1.2")
						say("mike", "Por algún motivo, me interesa esa maquina de tumores que tenes atras tuyo.")
						say("profe_escuela", "Ah, Estas hablando del nuevo y lujoso Vape3000, traido desde la imponente Wuhan en china. Con la ultima tecnologia de vaporizacion de metales pesados, es el favorito de los niños. Por dia me llevo 2 o 3 y se los vendo a los pibes atras de la escuela. Es la unica manera en la que puedo llegar a fin de mes.", "P_respuesta1.3")
						if "gaming" in inventory:
							say("mike", "¿Y si te lo cambio por esto? Una consola con el videojuego más esperado del año.")
							say("profe_escuela", "¿¡Una consola con videojuego!? Con esto no salgo más de mi casa. Trato hecho, pibe.")
							inventory_remove("gaming")
							vape_liberado = true
							custom("vape3000", "DropFX", "dropear")
							say("profe_escuela", "Ahí tenés tu máquina de tumores. Agarrala antes de que me arrepienta.")
							done
						else:
							say("profe_escuela", "Si me traés algo para jugar en casa de verdad, capaz lo hablamos.")

				- "> ¿Qué esta haciendo fuera del horario escolar aca escondido?"
					say("mike", "¿Qué esta haciendo fuera del horario escolar aca escondido?")
					say("profe_escuela", "Esta es la guarida más preciada. Con los potentes 512 kb de la escuela, puedo enfrascarme en aventuras epicas en el Argentum online. Puedo pasar horas pegado a la silla. Pero lo malo que en mi casa no tengo nada de estos lujosos aparatos asi que me tengo que conformar con el valero en mi mesa de luz.", "P_respuesta1.4")
					say("mike", "*(era mucho mas gordo de lo que me acordaba)*, Tremendo como el cole banca estas cosas.")

				- "> irse"
					say("mike", "Se me cuidan")
					done

		- "> ¿Tenés un pucho?"
			say("mike", "¿Tenés un pucho?")
			say("profe_escuela", "Yo no fumo, pibe. Lo mío es otra cosa...")
			done

		- "> irse"
			say("mike", "Se me cuidan")
			done

:use gaming
	global vape_liberado = false
	say("profe_escuela", "¿¡Una consola con videojuego!? Con esto no salgo más de mi casa. Trato hecho, pibe.")
	inventory_remove("gaming")
	vape_liberado = true
	custom("vape3000", "DropFX", "dropear")
	say("profe_escuela", "Ahí tenés tu máquina de tumores. Agarrala antes de que me arrepienta.")
